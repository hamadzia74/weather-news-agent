# ---------------------------------------------------------------
# Copy this file, rename the copy to ".env", and fill in your key.
#
#   Windows:  copy .env.example .env
#   Mac/Linux:  cp .env.example .env
#
# The real .env is ignored by git, so your key stays private.
# ---------------------------------------------------------------

# Get a FREE key at https://openrouter.ai/keys (no credit card needed).
OPENROUTER_API_KEY=paste-your-openrouter-key-here

# "openrouter/free" automatically picks whichever free model is working today,
# so it keeps running even when individual free models get retired or busy.
# Specific alternatives that also work: minimax/minimax-m3:free
#                                       nvidia/nemotron-3.5-lightning:free
MODEL_NAME=openrouter/free
